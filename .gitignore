# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# scratch
tmp/
_CLAUDE-INBOX/

# Claude Code local machine settings (per-machine, not shared)
.claude/settings.local.json

# Secrets. site/.env is deliberately tracked because it holds only DOMAIN and
# ACME_EMAIL, which are public facts the deploy needs. NEVER put an API key,
# token, or password in it. Anything genuinely secret goes in one of these
# instead, which are ignored:
.env.local
.env.*.local
.env.production
.env.secrets
secrets/
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json

# Content mirror: text only. The image and PDF masters stay on disk because they
# are ~1.74 GB and git is the wrong place for them. If they ever need to be
# versioned, use Git LFS rather than committing them here.
content/**/*.png
content/**/*.jpg
content/**/*.jpeg
content/**/*.pdf
content/**/*.woff2
content/**/*.docx
content/**/*.xlsx
content/**/*.zip

# generated preview, regenerate with python ops/send_brief.py --preview
ops/brief-preview.html

# audit_visual.py writes this beside the page it is measuring, then deletes it
# in a finally block. A run killed mid-audit (a timeout, a crash) can leave one
# behind; ignored here so a stray copy can never be committed by accident.
# gate_no_stray_probe_files in preflight.py catches one that already landed.
site/**/_visual_probe.html

# Python bytecode. Tracking it means every run of any script shows up
# as a repository change, and a stale .pyc can shadow a source edit.
__pycache__/
*.pyc
ops/last-brief.json

# Generated product files. 155 of them, rebuilt by ops/build_catalog.py from
# content.json in seconds. Committing 3 MB of derived HTML would bloat every
# clone for no benefit; the generator is the source of truth.
build/products/
build/heroes/
build/deck-review/
build/cards-rendered/
build/cardtext/
build/card-fronts/
build/video/test/
build/video/_frames/
build/models/
build/generated/
build/shots/

# Intermediate render scratch: per-beat TTS mp3s and PNG frames.
# These were tracked, so the narration batch dirtied the working tree
# continuously and every rebase failed with 'cannot rebase: you have
# unstaged changes'. A push that fails whenever a render is running is
# not a push that works every time.
build/video/_narr/
