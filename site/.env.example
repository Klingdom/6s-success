# Copy to ".env" and fill in, then deploy docker-compose.proxy.yml.
# These are only used by the HTTPS (proxy) stack; the plain 8973 stack ignores them.

# The domain the site answers on (its DNS A record must point at the VPS IP).
DOMAIN=6s-success.com

# Email Let's Encrypt uses for the certificate (renewal notices only).
ACME_EMAIL=you@example.com
