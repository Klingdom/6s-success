# HTTPS stack config (docker-compose.proxy.yml). Edit the two values, then deploy.
# The plain docker-compose.yml (IP:8973) does not use these.

# CHANGE ME: the domain the site answers on. Its DNS A record must point at the VPS IP.
DOMAIN=6ssuccess.example.com

# CHANGE ME: your email (Let's Encrypt renewal notices only).
ACME_EMAIL=you@example.com
