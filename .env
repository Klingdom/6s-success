# HTTPS stack config (docker-compose.proxy.yml). The plain docker-compose.yml (IP:8973)
# does not use these. Traefik reads them to route the domain and request the certificate.

# The domain the site answers on. Its DNS A record (and www) must point at the VPS IP.
DOMAIN=6s-success.com

# Email Let's Encrypt uses for the certificate (renewal notices only).
ACME_EMAIL=phil@mediafier.ai
