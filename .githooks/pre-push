#!/bin/sh
# Refuse to push an unresolved merge conflict.
#
# ops/preflight.py already has gate_conflict_markers, and it is correct: it
# scans *.md among other extensions and would have caught this. ops/ship.py
# refuses the same thing. Both were bypassed on 2026-09-11 by driving plain
# git: a merge left ops/NIGHTLY-LOG.md unresolved, a following `git add -A`
# staged it with the markers in it, and three lines of <<<<<<< reached main.
#
# That is the second time this exact shape has happened here. The first time,
# `git add -A` staged a conflicted ops/preflight.py, which Python then could
# not parse, so every gate in the file was dead. gate_conflict_markers was
# written that day. It did not help this time, because a gate you have to
# remember to run before pushing is not a control, it is a habit.
#
# This is the control. It runs at the moment the mistake would leave the
# machine, needs nothing remembered, and costs milliseconds.
#
# Deliberately NOT a call to preflight.py: that takes minutes, and a pre-push
# hook slow enough to be annoying is one somebody passes --no-verify to. This
# does one cheap scan of the tracked files most likely to carry a marker.
#
# --no-verify still bypasses it. That is fine; the point is that bypassing has
# to be a decision rather than an accident.
#
# `git grep` searches TRACKED files only. That is the right scope for a
# pre-push, because untracked files are not what you are pushing, but it
# means a marker dropped into a new unversioned file will not trip this. The
# first attempt to fail-prove this hook did exactly that, saw exit 0, and
# briefly looked like the hook did not work. It does; the test was wrong.

bad=$(git grep -lE '^(<{7} |>{7} |={7}$)' -- \
        '*.md' '*.py' '*.json' '*.html' '*.css' '*.js' '*.yml' 2>/dev/null)

if [ -n "$bad" ]; then
  echo "pre-push: unresolved merge conflict markers in:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "" >&2
  echo "Resolve them, then push. To bypass: git push --no-verify" >&2
  exit 1
fi

# Refuse to push ops/NIGHTLY-LOG.md out of order.
#
# Found 2026-10-20: a cycle appended its entry (and two more after it) to the
# tail of this newest-first file instead of prepending it to the top. CI's
# own gate_tests caught it on push, correctly, but every cloud-sandbox cycle
# between that broken push and the next CI read kept reporting a clean local
# preflight, because this sandbox's gate_tests hangs on a headless Chromium
# check and preflight.py never reaches gate_nightly_log_ordering, the gate
# already written for this exact shape after it happened once before
# (2026-09-05) and was widened once before that (2026-10-15). A control
# nobody reaches before pushing is not a control.
#
# ops/check_nightly_log_fast.py runs the same three gates (size, ordering, no
# duplicate entries) with nothing but the file on disk: no browser, no
# network, no Stripe key, under a second.
# Git runs hooks with the working tree's top level as cwd, so a plain
# relative path reaches ops/ the same way the pre-commit hook's own
# HOOK_DIR-relative calls reach .githooks/.
#
# Found 2026-10-22: this used to test `command -v python3` and then run it.
# On Windows `python3` is usually the Microsoft Store placeholder, which is
# on PATH but only prints "Python was not found" and exits non-zero, so the
# hook refused every push without checking anything. Same rule as
# pre-commit: each candidate must prove it runs, not merely be present.
# And no working interpreter is a refusal, not a silent skip.
if [ -f "ops/check_nightly_log_fast.py" ]; then
  PY=""
  for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1 &&
       "$cand" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
      PY="$cand"
      break
    fi
  done
  if [ -z "$PY" ]; then
    echo "pre-push: no working python found, so ops/NIGHTLY-LOG.md could not" >&2
    echo "be checked. Refusing rather than pushing it unexamined." >&2
    exit 1
  fi
  if ! "$PY" ops/check_nightly_log_fast.py; then
    echo "" >&2
    echo "Fix ops/NIGHTLY-LOG.md, then push. To bypass: git push --no-verify" >&2
    exit 1
  fi
fi

exit 0
